<Window x:Class="Darkwire.Host.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Darkwire.Host" Style="{StaticResource {x:Type Window}}" Title="Darkwire" Width="1480" Height="940" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6"/></WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource Background}" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag">
        <Grid>
          <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center"><Image x:Name="TitleIcon" Width="25" Height="29" Margin="0,0,11,0"/><TextBlock Text="darkwire" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0" Margin="20,4,0,4" Padding="18,0,0,0"><TextBlock Text="NETWORK CONTROL" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/></Border></StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="—" Width="48" Click="MinimizeClick" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Minimize"/><Button Content="□" Width="48" Click="MaximizeClick" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Maximize or restore"/><Button Content="✕" Width="48" Click="CloseClick" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Close"/></StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="202"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition x:Name="NavigationRow" Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="NavigationShell" Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
          <DockPanel x:Name="NavigationLayout" Margin="13,25,13,18">
            <StackPanel x:Name="DeviceSection" DockPanel.Dock="Top" Margin="13,0,0,28"><TextBlock Text="YOUR WORKSPACE" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock Text="This device" FontSize="16" FontWeight="Medium" Margin="0,9,0,6"/><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="{DynamicResource Accent}" Margin="0,0,7,0"/><TextBlock x:Name="DeviceLabel" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></StackPanel>
            <StackPanel x:Name="NavigationFooter" DockPanel.Dock="Bottom">
              <Border x:Name="AuthorityCard" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="11,17,11,4" Margin="0,0,0,12"><DockPanel><local:StatusShield x:Name="Shield" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Top"/><StackPanel><TextBlock x:Name="AuthorityTitle" Text="MONITOR ONLY" Foreground="{DynamicResource Warning}" FontSize="11" FontWeight="Medium"/><TextBlock x:Name="AuthorityDetail" Text="Windows Firewall unchanged." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
              <Button x:Name="SettingsNavigation" Tag="Settings" Click="NavigateClick" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" Margin="0,0,11,0"/><TextBlock Text="Settings"/></StackPanel></Button>
              <TextBlock x:Name="VersionLabel" Text="DARKWIRE" Foreground="{DynamicResource Muted}" FontSize="10" Margin="14,17,0,0"/>
            </StackPanel>
            <StackPanel x:Name="Navigation">
              <Button Tag="Overview" Click="NavigateClick" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE80F;" Margin="0,0,11,0"/><TextBlock Text="Overview"/></StackPanel></Button>
              <Button Tag="Connections" Click="NavigateClick" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE968;" Margin="0,0,11,0"/><TextBlock Text="Connections"/></StackPanel></Button>
              <Button Tag="Map" Click="NavigateClick" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE774;" Margin="0,0,11,0"/><TextBlock Text="Connection map"/></StackPanel></Button>
              <TextBlock x:Name="PolicyNavHeading" Text="POLICIES" Foreground="{DynamicResource Muted}" FontSize="10" Margin="14,26,0,10"/>
              <Button Tag="Rules" Click="NavigateClick" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A4;" Margin="0,0,11,0"/><TextBlock Text="Firewall rules"/></StackPanel></Button>
              <Button Tag="VPN" Click="NavigateClick" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE705;" Margin="0,0,11,0"/><TextBlock Text="VPN profiles"/></StackPanel></Button>
              <Button Tag="Blocklists" Click="NavigateClick" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72E;" Margin="0,0,11,0"/><TextBlock Text="Blocklists"/></StackPanel></Button>
              <Button Tag="Regions" Click="NavigateClick" Style="{StaticResource NavButton}"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE707;" Margin="0,0,11,0"/><TextBlock Text="Regions &amp; ASN"/></StackPanel></Button>
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid Grid.Row="1" Grid.Column="1" Margin="30,25,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
          <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
            <DockPanel><Button DockPanel.Dock="Right" Content="Restart Darkwire" Style="{StaticResource Primary}" VerticalAlignment="Center" Click="RestartForUpdateClick"/>
              <StackPanel Margin="0,0,16,0"><TextBlock Text="Darkwire was updated" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock Text="This window still runs the version it started with. Restart it to use the new one; filtering and VPN tunnels carry on meanwhile." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel>
          </Border>
          <Border x:Name="TunnelsBanner" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">
            <DockPanel><TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons" Text="&#xE895;" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <StackPanel><TextBlock x:Name="TunnelsBannerTitle" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/><TextBlock x:Name="TunnelsBannerDetail" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></DockPanel>
          </Border>
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock x:Name="PageEyebrow" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock x:Name="PageTitle" FontSize="30" FontWeight="Medium" Margin="0,7,0,7"/><TextBlock x:Name="PageDescription" Foreground="{DynamicResource Muted}" FontSize="13" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="5" Padding="10,6"><TextBlock x:Name="SourceLabel" FontSize="10" Foreground="{DynamicResource Accent}"/></Border><Button Content="↻" FontSize="20" Padding="10,3" Margin="10,0,0,0" ToolTip="Refresh connections" AutomationProperties.Name="Refresh connections" Click="RefreshClick"/></StackPanel></Grid>
          <ContentControl x:Name="PageContent" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          <Border x:Name="Toast" Grid.Row="3" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,12,0,0"><TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="{DynamicResource Text}"/></Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterStatus" Text="Policy preview · Changes are not enforced" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="RenderStatus" Grid.Column="1" FontSize="10" Foreground="{DynamicResource Muted}" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
  </Border>
</Window>
